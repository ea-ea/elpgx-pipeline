/*
 * ElPGx Pipeline Configuration
 *
 * Clinical Pharmacogenetics Analysis Pipeline
 * Production-ready for Seven Bridges and cloud platforms
 * Author: Elif Arslan
 */

// Pipeline version
manifest {
    name            = 'elpgx-pipeline'
    author          = 'Elif Arslan'
    homePage        = 'https://github.com/ea-ea/elpgx-pipeline'
    description     = 'ElPGx - Clinical Pharmacogenetics Analysis Pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '1.1.0'
}

// Default parameters
params {
    // Input files
    input               = null          // BAM/CRAM file (required)
    reference           = null          // Reference FASTA (required)

    // Data directories
    pgx_db              = "${projectDir}/data/allele_definitions"
    phenotype_maps      = "${projectDir}/data/phenotype_maps"
    implications        = "${projectDir}/data/prescribing_implications"
    pgx_regions         = "${projectDir}/data/pgx_regions.bed"
    gene_tiers_file     = "${projectDir}/data/gene_tiers.json"

    // Analysis options
    gene_tiers          = 'group1'      // Comma-separated: 'group1,group2,group3'
    enable_hla          = false         // Enable HLA calling module

    // Variant calling thresholds
    min_mapping_quality = 20
    min_base_quality    = 20
    min_depth           = 10
    min_genotype_quality = 20

    // Confidence calculation
    target_depth        = 30
    max_quality         = 100

    // Output
    outdir              = './results'
    publish_dir_mode    = 'copy'

    // Schema validation
    schema_path         = "${projectDir}/schemas/elpgx_report_schema.json"
    strict_validation   = true

    // Provenance (auto-populated at runtime)
    pgx_db_version      = 'CPIC v1.24'
}

// Process-specific configuration
process {
    // Default error handling
    errorStrategy = 'retry'
    maxRetries    = 2

    // Process-specific containers and resources
    withName: 'VALIDATE_INPUT' {
        container = 'elifffarslan/elpgx-python:1.1.0'
        cpus      = 1
        memory    = 2.GB
    }

    withName: 'VARIANT_CALL' {
        container = 'broadinstitute/gatk:4.5.0.0'
        cpus      = 4
        memory    = 8.GB
        time      = 4.h
    }

    withName: 'ALLELE_CALL' {
        container = 'elifffarslan/elpgx-python:1.1.0'
        cpus      = 2
        memory    = 4.GB
    }

    withName: 'HLA_CALL' {
        container = 'elifffarslan/elpgx-hla:1.1.0'
        cpus      = 4
        memory    = 8.GB
        time      = 2.h
    }

    withName: 'PHENOTYPE_TRANSLATE' {
        container = 'elifffarslan/elpgx-python:1.1.0'
        cpus      = 1
        memory    = 2.GB
    }

    withName: 'GENERATE_REPORT' {
        container = 'elifffarslan/elpgx-python:1.1.0'
        cpus      = 1
        memory    = 2.GB
    }
}

// Profiles
profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '--entrypoint ""'
        singularity.enabled    = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // Seven Bridges platform profile
    sevenbridges {
        docker.enabled         = true
        process.executor       = 'sbg'
    }

    // AWS Batch profile
    awsbatch {
        process.executor       = 'awsbatch'
        process.queue          = 'default'
        aws.region             = 'us-east-1'
        docker.enabled         = true
    }

    // Local execution profile
    local {
        executor.name          = 'local'
        executor.cpus          = 8
        executor.memory        = 16.GB
    }

    // Test profile
    test {
        params.input           = "${projectDir}/tests/fixtures/test_sample.bam"
        params.reference       = "${projectDir}/tests/fixtures/test_reference.fa"
        params.outdir          = "${projectDir}/tests/results"
    }
}

// Execution reports
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

// Capture version information for provenance
env {
    PIPELINE_VERSION = manifest.version
    ELPGX_VERSION    = manifest.version
}
